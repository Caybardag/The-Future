{
  "id": "com.futurist2060.app",
  "name": "Teknolojik Evrim Takvimi",
  "short_name": "Evrim Takvimi",
  "description": "2026-2060 Teknolojik Evrim Takvimi ve Gelecek Simülatörü",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["tabbed", "window-controls-overlay", "standalone", "minimal-ui"],
  "tab_strip": {
    "home_tab": {
      "scope": "/",
      "url": "/",
      "title": "Evrim Zaman Çizelgesi"
    },
    "new_tab_button": {
      "url": "/?tab=news"
    }
  },
  "orientation": "any",
  "background_color": "#0B0F19",
  "theme_color": "#0B0F19",
  "lang": "tr-TR",
  "dir": "ltr",
  "categories": ["productivity", "education", "utilities", "news"],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.futurist2060.app",
      "id": "com.futurist2060.app"
    }
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "scope_extensions": [
    {
      "origin": "https://ais-pre-pn4tvxywtc4qdpkfhf4p3e-434893325646.europe-west1.run.app"
    },
    {
      "origin": "https://ais-dev-pn4tvxywtc4qdpkfhf4p3e-434893325646.europe-west1.run.app"
    },
    {
      "origin": "*.europe-west1.run.app"
    },
    {
      "origin": "*.run.app"
    }
  ],
  "share_target": {
    "action": "/?tab=news",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+futurist",
      "url": "/?timeline_signal=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/?tab=timeline",
      "name": "Futurist Timeline JSON Data",
      "accept": {
        "application/json": [".json"]
      }
    }
  ],
  "note_taking": {
    "new_note_url": "/?tab=timeline&action=new_note"
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "widgets": [
    {
      "name": "Gelecek AI Sinyali Widget",
      "short_name": "AI Sinyali",
      "description": "En son doğrulanmış 2060 teknoloji öngörüsü",
      "tag": "futurist-widget",
      "template": "widget-template",
      "ms_ac_template": "widget.json",
      "data": "widget-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshot-mobile.png",
          "sizes": "750x1334",
          "label": "Mobil Widget Önizlemesi"
        }
      ],
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
