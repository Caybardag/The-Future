# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Settings / Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENALEX_API_KEY: Optional OpenAlex API key or mailto for polite pool
OPENALEX_API_KEY=""
OPENALEX_MAILTO="warfacelove46@gmail.com"

# TELEGRAM_API_ID & TELEGRAM_API_HASH: Telegram MTProto User Client API credentials
TELEGRAM_API_ID="33300402"
TELEGRAM_API_HASH="79e241623766827f9b2ac480065656b6"

# TELEGRAM_BOT_TOKEN: Telegram BotFather'dan aldığınız Bot Token'ı (Örn: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
# Sunucu arka planda bot üzerinden kanalı 7/24 dinler ve mesajları doğrudan yapay zekaya aktarır.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_DESTINATION_CHANNEL: Botun yönetici olduğu ve mesajların aktarıldığı kendi kanalınızın ID'si (Örn: -1004388658742)
TELEGRAM_DESTINATION_CHANNEL="-1004388658742"

# ADMIN_NOTIFY_EMAIL: Sponsorluk başvuruları ve sistem uyarılarının iletildiği yönetici e-posta adresi
ADMIN_NOTIFY_EMAIL="warfacelove46@gmail.com"

# CUSTOM DOMAIN & ORIGINS (Özel Alan Adı Yapılandırması)
# Kendi alan adınızı bağladığınızda buraya yazınız (Örn: https://teknolojikevrim.com)
CUSTOM_DOMAIN=""
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# STANDALONE FIREBASE CONFIG (Kendi Bağımsız Firebase Projenize Geçiş)
# Client-side (Vite)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID="(default)"

# Server-side (Cloud Run / Node.js)
FIREBASE_PROJECT_ID=""
FIRESTORE_DATABASE_ID="(default)"
FIREBASE_API_KEY=""

